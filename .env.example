# Default preview: unmistakably labeled sample dates, never live availability.
AVAILABILITY_MODE=demo
NEXT_PUBLIC_AVAILABILITY_MODE=demo

# To go live, set BOTH modes to google, configure the private values below,
# then rebuild. Never use NEXT_PUBLIC_ for calendar IDs or credentials.
GOOGLE_CALENDAR_ID=your-dedicated-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-reader@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
PROPERTY_TIMEZONE=Asia/Kolkata
AVAILABILITY_CACHE_SECONDS=60
AVAILABILITY_REFRESH_SECONDS=60
GOOGLE_CALENDAR_TIMEOUT_MS=8000

# Leave blank unless the owner has confirmed a minimum-stay policy.
MIN_STAY_NIGHTS=

# Optional separate API origin for static hosting, e.g. https://api.example.com
# Leave blank when using npm start, which serves the site and API together.
NEXT_PUBLIC_AVAILABILITY_API_URL=
AVAILABILITY_ALLOWED_ORIGIN=
PORT=3000

# Use 0.0.0.0 when running on a production Node host.
LITSTAYS_HOST=127.0.0.1
