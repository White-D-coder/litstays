{
  "name": "the-lit-stays",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node --import tsx --env-file-if-exists=.env.local scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
